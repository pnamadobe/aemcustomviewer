{
  "manifest_version": 3,
  "name": "AEM Assets View – Custom Viewer",
  "version": "0.3.0",
  "description": "Renders proprietary, 3D, DPC trim/fabric (U3MA, FBX, USDZ, SBSAR), font, and RAW formats in Assets View.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://experience.adobe.com/*",
    "https://*.adobeaemcloud.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AEM Assets View – Custom Viewer",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://experience.adobe.com/thunderbird/solutions/CQ-assets-app*",
        "https://experience.adobe.com/solutions/CQ-assets-app*"
      ],
      "js": ["dist/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://experience.adobe.com/thunderbird/solutions/CQ-assets-app*",
        "https://experience.adobe.com/solutions/CQ-assets-app*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/viewers/*"],
      "matches": ["https://experience.adobe.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
